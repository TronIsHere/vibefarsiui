{
  "name": "@vibefarsi/mcp",
  "version": "0.1.0",
  "description": "MCP server for VibeFarsi. Gives Cursor, Claude Code, and Windsurf Persian RTL design rules and registry components so they stop emitting Inter, Latin digits, and LTR layout.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vibefarsi-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  },
  "files": ["dist"],
  "homepage": "https://vibefarsi.ir",
  "bugs": {
    "url": "https://github.com/TronIsHere/vibefarsiui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TronIsHere/vibefarsiui.git",
    "directory": "mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "persian",
    "farsi",
    "rtl",
    "react",
    "tailwind"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
