{
  "name": "vibefarsi-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "vibefarsi": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node -e \"process.exit(require('fs').existsSync('mcp/dist/server.js')?0:1)\" || npm run build --prefix mcp",
    "build": "npm run build --prefix mcp && next build",
    "build:cli": "tsc -p packages/cli/tsconfig.json",
    "start": "next start",
    "lint": "eslint",
    "mcp": "npm run dev --prefix mcp",
    "mcp:smoke": "npm run smoke --prefix mcp",
    "vibefarsi": "node packages/cli/dist/index.js",
    "previews": "node scripts/capture-previews.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/browser": "^4.3.3",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "sucrase": "^3.35.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
